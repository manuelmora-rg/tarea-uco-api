# =============================================================================
# One Piece Explorer - variables de entorno
# Copia este archivo como .env en la raíz del proyecto.
# NUNCA subas credenciales reales al repositorio.
# =============================================================================

# --- Backend -----------------------------------------------------------------
# NODE_ENV no se define aquí: Vite comparte este archivo y usa NODE_ENV para
# decidir entre build de desarrollo y de producción. El backend asume
# "development" por defecto. En producción defínelo en el proceso:
#   NODE_ENV=production npm start
PORT=4000

# Proveedor de datos. Valores soportados: onepiece_multisource | onepiece_v2
# onepiece_v2 desactiva el enriquecimiento y conserva el comportamiento anterior.
# El frontend no cambia al sustituir este valor.
DATA_PROVIDER=onepiece_multisource

# API externa principal de datos (api-onepiece.com v2)
ONEPIECE_API_BASE_URL=https://api.api-onepiece.com/v2
# La API externa solo admite en | fr
ONEPIECE_API_LOCALE=en
ONEPIECE_API_TIMEOUT_MS=15000

# Fuente complementaria de imágenes y datos: onepieceapi | none
IMAGE_PROVIDER=onepieceapi
# El host www evita la redirección 308 del dominio sin www.
ONEPIECEAPI_BASE_URL=https://www.onepieceapi.com/api
ONEPIECEAPI_TIMEOUT_MS=15000
ONEPIECEAPI_PAGE_SIZE=100
ONEPIECEAPI_MAX_PAGES=60
# Espera máxima al catálogo de imágenes antes de responder con los datos base.
# La carga continúa en segundo plano; 0 desactiva el límite.
IMAGE_ENRICHMENT_WAIT_MS=4000

# Caché en memoria de los catálogos normalizados
CACHE_TTL_MS=600000

# CORS: orígenes permitidos separados por coma (usa * solo en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Límite de peticiones a nuestra API
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Proxy de imágenes: solo se permiten estos hosts (separados por coma)
MEDIA_ALLOWED_HOSTS=images.api-onepiece.com,hlryizauzapedkefdviw.supabase.co
MEDIA_MAX_BYTES=8000000

# --- Frontend ----------------------------------------------------------------
# Ruta base de nuestra API (se usa el proxy de Vite en desarrollo)
VITE_API_URL=/api
